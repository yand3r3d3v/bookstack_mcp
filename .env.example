# Settings for the HTTP server (npm run serve / docker compose). Copy to .env and fill in.

# Your BookStack.
BOOKSTACK_URL=https://wiki.example.com

# The public address of this server, as Claude will reach it — including the sub-path, if any.
# The MCP endpoint is this plus /mcp.
MCP_PUBLIC_URL=https://tools.example.com/bookstack-mcp

# Encrypts the sign-in tokens handed out to Claude (they contain users' BookStack API tokens).
# Generate with: openssl rand -base64 32. Changing it signs everyone out.
MCP_AUTH_SECRET=

# Hosts OAuth may redirect to after sign-in. Default: claude.ai,claude.com,localhost,127.0.0.1,[::1]
# MCP_ALLOWED_REDIRECT_HOSTS=

# true: only read tools, no creating/editing.
# BOOKSTACK_READ_ONLY=false

# Port on the Docker host (compose only).
# HOST_PORT=3000
